{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quiet-benefits-header {
    text-align: center;
    margin-bottom: 4.0rem;
  }

  .quiet-benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    .quiet-benefits-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.2rem;
    }
  }

  .quiet-benefit-card {
    background-color: var(--color-quiet-ivory);
    border: 1px solid var(--color-quiet-border);
    border-radius: var(--quiet-radius-base);
    padding: 3.2rem 2.4rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform var(--quiet-transition-base), box-shadow var(--quiet-transition-base);
  }

  .quiet-benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--quiet-shadow-card);
  }

  .quiet-benefit-icon-wrap {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: var(--quiet-radius-pill);
    background-color: var(--color-quiet-cream);
    border: 1px solid var(--color-quiet-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.0rem;
    color: var(--color-quiet-terracotta);
    font-size: 2.2rem;
  }

  .quiet-benefit-title {
    font-family: var(--font-quiet-serif);
    font-size: 2.0rem;
    font-weight: 600;
    color: var(--color-quiet-charcoal);
    margin: 0 0 1.0rem;
  }

  .quiet-benefit-text {
    font-family: var(--font-quiet-sans);
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-quiet-charcoal-rgb), 0.8);
    margin: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="quiet-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="quiet-benefits-header">
        {%- if section.settings.subheading != blank -%}
          <span class="quiet-eyebrow">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="quiet-editorial-heading quiet-heading--lg">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="quiet-benefits-grid">
      {%- for block in section.blocks -%}
        <div class="quiet-benefit-card" {{ block.shopify_attributes }}>
          <div class="quiet-benefit-icon-wrap" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'feather' -%}
                ✍︎
              {%- when 'gift' -%}
                🎁
              {%- when 'heart' -%}
                ♡
              {%- when 'sparkle' -%}
                ✧
              {%- else -%}
                📖
            {%- endcase -%}
          </div>
          <h3 class="quiet-benefit-title">{{ block.settings.title | escape }}</h3>
          <p class="quiet-benefit-text">{{ block.settings.description | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three-Column Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why The Quiet Page"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mindful craftsmanship in every detail"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "book", "label": "Book" },
            { "value": "feather", "label": "Feather / Pen" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "book"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtfully curated"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Archival materials chosen to honor your words for a lifetime."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three-Column Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "book",
            "title": "Thoughtfully curated",
            "description": "Archival materials and lay-flat binding chosen to honor your words."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "feather",
            "title": "Made for your rhythm",
            "description": "Undated prompts and mindful layouts adapted to your natural flow."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "gift",
            "title": "Gift-ready moments",
            "description": "Hand-wrapped packaging and custom gift notes with every order."
          }
        }
      ]
    }
  ]
}
{% endschema %}