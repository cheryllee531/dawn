{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quiet-inspiration-header {
    text-align: center;
    margin-bottom: 3.6rem;
  }

  .quiet-inspiration-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    .quiet-inspiration-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.2rem;
    }
  }

  .quiet-article-card {
    background-color: var(--color-quiet-ivory);
    border: 1px solid var(--color-quiet-border);
    border-radius: var(--quiet-radius-base);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--quiet-transition-base), box-shadow var(--quiet-transition-base);
    text-decoration: none;
    color: inherit;
  }

  .quiet-article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--quiet-shadow-card);
  }

  .quiet-article-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-quiet-cream);
  }

  .quiet-article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--quiet-transition-smooth);
  }

  .quiet-article-card:hover .quiet-article-image {
    transform: scale(1.04);
  }

  .quiet-article-content {
    padding: 2.0rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .quiet-article-category {
    font-family: var(--font-quiet-sans);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-quiet-terracotta);
    margin-bottom: 0.8rem;
  }

  .quiet-article-title {
    font-family: var(--font-quiet-serif);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--color-quiet-charcoal);
    margin: 0 0 0.8rem;
    line-height: 1.3;
  }

  .quiet-article-excerpt {
    font-family: var(--font-quiet-sans);
    font-size: 1.35rem;
    color: rgba(var(--color-quiet-charcoal-rgb), 0.75);
    line-height: 1.5;
    margin: 0 0 1.6rem;
  }

  .quiet-article-link-text {
    font-family: var(--font-quiet-sans);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-quiet-terracotta);
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="quiet-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="quiet-inspiration-header">
        {%- if section.settings.subheading != blank -%}
          <span class="quiet-eyebrow">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="quiet-editorial-heading quiet-heading--lg">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="quiet-inspiration-grid">
      {%- if section.settings.blog != blank and section.settings.blog.articles.size > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <a href="{{ article.url }}" class="quiet-article-card">
            <div class="quiet-article-media">
              {%- if article.image != blank -%}
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 800',
                    class: 'quiet-article-image',
                    alt: article.title | escape
                }}
              {%- else -%}
                <div class="quiet-hero-placeholder">
                  {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="quiet-article-content">
              <span class="quiet-article-category">Journal Entry</span>
              <h3 class="quiet-article-title">{{ article.title | escape }}</h3>
              <p class="quiet-article-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
              <span class="quiet-article-link-text">Read more &rarr;</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '/blogs/news' }}" class="quiet-article-card" {{ block.shopify_attributes }}>
            <div class="quiet-article-media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 800',
                    class: 'quiet-article-image',
                    alt: block.settings.title | escape
                }}
              {%- else -%}
                <div class="quiet-hero-placeholder">
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="quiet-article-content">
              <span class="quiet-article-category">{{ block.settings.category | default: 'Mindful Practice' }}</span>
              <h3 class="quiet-article-title">{{ block.settings.title | escape }}</h3>
              <p class="quiet-article-excerpt">{{ block.settings.excerpt | escape }}</p>
              <span class="quiet-article-link-text">{{ block.settings.link_text | default: 'Read more' }} &rarr;</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial Blog / Inspiration Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notes on Stillness & Practice"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Journaling essays, rituals, and inspiration"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Shopify Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Post Limit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "editorial_card",
      "name": "Editorial Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Mindful Practice"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article Title",
          "default": "The Architecture of a Quiet Morning"
        },
        {
          "type": "text",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "How setting aside ten minutes before digital noise reshapes focus, creative energy, and emotional clarity."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Read more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Blog / Inspiration Cards",
      "blocks": [
        {
          "type": "editorial_card",
          "settings": {
            "category": "Rituals",
            "title": "The Architecture of a Quiet Morning",
            "excerpt": "Setting aside ten minutes before digital noise reshapes focus and inner clarity."
          }
        },
        {
          "type": "editorial_card",
          "settings": {
            "category": "Writing Prompts",
            "title": "Five Questions for Evening Reflection",
            "excerpt": "Gentle inquiry to release tension, celebrate small victories, and ground your thoughts."
          }
        },
        {
          "type": "editorial_card",
          "settings": {
            "category": "Craftsmanship",
            "title": "Why Tactile Paper Still Matters",
            "excerpt": "The neuroscience of handwriting on heavy archival fibers versus tapping glass."
          }
        }
      ]
    }
  ]
}
{% endschema %}