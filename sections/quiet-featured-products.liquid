{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quiet-featured-header {
    text-align: center;
    margin-bottom: 3.6rem;
  }

  .quiet-products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .quiet-products-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: 2.4rem;
    }
  }

  .quiet-product-card {
    background-color: var(--color-quiet-ivory);
    border: 1px solid var(--color-quiet-border);
    border-radius: var(--quiet-radius-base);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--quiet-transition-base), box-shadow var(--quiet-transition-base);
  }

  .quiet-product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--quiet-shadow-card);
  }

  .quiet-product-media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-quiet-cream);
  }

  .quiet-product-badge {
    position: absolute;
    top: 1.0rem;
    left: 1.0rem;
    z-index: 2;
  }

  .quiet-product-info {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .quiet-product-title {
    font-family: var(--font-quiet-serif);
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--color-quiet-charcoal);
    margin: 0 0 0.6rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .quiet-product-price {
    font-family: var(--font-quiet-sans);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-quiet-charcoal);
    margin-bottom: 1.2rem;
  }

  .quiet-product-price--compare {
    text-decoration: line-through;
    color: rgba(var(--color-quiet-charcoal-rgb), 0.5);
    margin-right: 0.6rem;
    font-weight: 400;
  }

  .quiet-product-quick-add {
    margin-top: auto;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="quiet-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="quiet-featured-header">
        {%- if section.settings.subheading != blank -%}
          <span class="quiet-eyebrow">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="quiet-editorial-heading quiet-heading--lg">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="quiet-products-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div class="quiet-product-card">
            <div class="quiet-product-media">
              <a href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 450, 600',
                      class: 'quiet-hero-image',
                      alt: product.title | escape
                  }}
                {%- else -%}
                  <div class="quiet-hero-placeholder">
                    {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </a>
            </div>

            <div class="quiet-product-info">
              <a href="{{ product.url }}" class="quiet-product-title">
                {{ product.title | escape }}
              </a>
              <div class="quiet-product-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="quiet-product-price--compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                <span>{{ product.price | money }}</span>
              </div>

              {%- if section.settings.enable_quick_add -%}
                <div class="quiet-product-quick-add">
                  <a href="{{ product.url }}" class="quiet-btn-secondary" style="width: 100%; min-height: 3.8rem; font-size: 1.25rem;">
                    View Product
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="quiet-product-card">
            <div class="quiet-product-media">
              <div class="quiet-hero-placeholder">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="quiet-product-badge">
                <span class="quiet-tag quiet-tag--bestseller">Best Seller</span>
              </div>
            </div>
            <div class="quiet-product-info">
              <span class="quiet-product-title">Mindful Linen Daily Journal</span>
              <div class="quiet-product-price">
                <span class="quiet-product-price--compare">$36.00</span>
                <span>$28.00</span>
              </div>
              <div class="quiet-product-quick-add">
                <button class="quiet-btn-secondary" style="width: 100%; min-height: 3.8rem; font-size: 1.25rem;">
                  Quick Add
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful tools for every page."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bestsellers & New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to Show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on Desktop"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable Quick Add",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}