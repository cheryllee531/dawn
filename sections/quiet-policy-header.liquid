{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quiet-policy-header-inner {
    text-align: center;
    max-width: 78rem;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-quiet-border);
    padding-bottom: 2.4rem;
  }

  .quiet-policy-updated {
    font-family: var(--font-quiet-sans);
    font-size: 1.25rem;
    color: rgba(var(--color-quiet-charcoal-rgb), 0.6);
    margin-top: 1.2rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="quiet-container">
    <div class="quiet-policy-header-inner">
      {%- if section.settings.subtitle != blank -%}
        <span class="quiet-eyebrow">{{ section.settings.subtitle | escape }}</span>
      {%- endif -%}

      <h1 class="quiet-editorial-heading quiet-heading--xl">
        {{ section.settings.title | default: page.title | escape }}
      </h1>

      {%- if section.settings.last_updated != blank -%}
        <p class="quiet-policy-updated">{{ section.settings.last_updated | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Policy Page Header",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Store Policies"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Eyebrow / Subtitle",
      "default": "Clarity and care in every order."
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last Updated Notice",
      "default": "Last updated: August 2026"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Policy Page Header"
    }
  ]
}
{% endschema %}