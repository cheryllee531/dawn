{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quiet-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .quiet-hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 5.6rem;
    }
    .quiet-hero-grid--image-first {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .quiet-hero-grid--image-first .quiet-hero-media {
      order: -1;
    }
  }

  .quiet-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .quiet-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-top: 2.8rem;
  }

  .quiet-hero-media {
    width: 100%;
    border-radius: var(--quiet-radius-base);
    overflow: hidden;
    box-shadow: var(--quiet-shadow-card);
    border: 1px solid var(--color-quiet-border);
  }

  .quiet-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 4 / 3;
    transition: transform var(--quiet-transition-smooth);
  }

  .quiet-hero-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-quiet-cream);
    display: flex;
    align-items: center;
    justify-content: center;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="quiet-container">
    <div class="quiet-hero-grid{% if section.settings.layout == 'image_first' %} quiet-hero-grid--image-first{% endif %}">
      <div class="quiet-hero-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="quiet-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="quiet-editorial-heading quiet-heading--display">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="quiet-lead rte">
            {{ section.settings.body }}
          </div>
        {%- endif -%}

        <div class="quiet-hero-actions">
          {%- if section.settings.primary_button_label != blank -%}
            <a
              href="{{ section.settings.primary_button_link | default: '/collections/journals' }}"
              class="quiet-btn-primary"
            >
              {{ section.settings.primary_button_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: '/collections/gift-sets' }}"
              class="quiet-btn-secondary"
            >
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="quiet-hero-media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '375, 550, 750, 1100, 1500',
              class: 'quiet-hero-image',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="quiet-hero-placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quiet Page Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Subheading",
      "default": "Mindful Stationery & Guided Journals"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A quiet place for your thoughts."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>Thoughtfully crafted tools designed to bring intention, stillness, and creative focus to your daily rhythm.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        {
          "value": "text_first",
          "label": "Text First"
        },
        {
          "value": "image_first",
          "label": "Image First"
        }
      ],
      "default": "text_first"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary CTA Label",
      "default": "Shop Journals"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary CTA Label",
      "default": "Explore Gift Sets"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Quiet Page Hero"
    }
  ]
}
{% endschema %}